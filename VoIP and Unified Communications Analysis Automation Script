# Logging Function
function Log-Message {
    param (
        [string]$Message,
        [string]$Type = "INFO"
    )
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    Write-Output "[$timestamp] [$Type] $Message"
}

# Search for Calls in the Analytics System
function SearchCalls {
    Log-Message "Searching for calls based on the provided criteria..."
    $searchPayload = @{
        callingNumber = $callingNumber
        calledNumber = $calledNumber
        startDateTime = $startDateTime
        endDateTime = $endDateTime
        timeZone = $timeZone
    } | ConvertTo-Json -Depth 10

    try {
        $response = Invoke-RestMethod -Uri $callSearchEndpoint -Method Post -Headers $headers -Body $searchPayload
        if ($response -eq $null -or $response.calls.Count -eq 0) {
            Log-Message "No calls found for the specified criteria." "ERROR"
            return $null
        }
        Log-Message "Found $($response.calls.Count) calls matching the criteria."
        return $response.calls
    } catch {
        Log-Message "Error while searching for calls: $_" "ERROR"
        return $null
    }
}

# Analyze Call Details and Generate Call Flow Summary
function Analyze-CallDetails {
    param (
        [array]$Calls
    )
    $callSummaries = @()

    foreach ($call in $Calls) {
        $callId = $call.id
        Log-Message "Fetching details for Call ID: $callId..."

        try {
            # Fetching call details (this is a mock call to your actual API endpoint)
            $callDetailsResponse = Invoke-RestMethod -Uri "$callDetailsEndpoint/$callId" -Method Get -Headers $headers
            $sipResponses = $callDetailsResponse.sipResponses
            $packetLoss = $callDetailsResponse.packetLoss
            $mosScore = $callDetailsResponse.mosScore
            $responseDetails = $callDetailsResponse.responseDetails
            $ucIssues = $callDetailsResponse.ucIssues  # UC-specific issues (user presence, routing, etc.)

            # Start creating the call flow summary
            $summary = "Call ID: $callId`nSIP Responses:`n"
            
            # Analyzing SIP responses (VoIP)
            foreach ($responseDetail in $responseDetails) {
                $sipResponse = $responseDetail.responseCode
                $sourceIP = $responseDetail.sourceIP
                $sourceType = $responseDetail.sourceType

                if ($successfullSipResponses[$sipResponse]) {
                    $summary += "`tResponse Code: $sipResponse - $($successfullSipResponses[$sipResponse]) - Source: $sourceType ($sourceIP)`n"
                } elseif ($failureSipResponses[$sipResponse]) {
                    $summary += "`tResponse Code: $sipResponse - $($failureSipResponses[$sipResponse]) - Source: $sourceType ($sourceIP)`n"
                } else {
                    $summary += "`tResponse Code: $sipResponse - Unknown Response - Source: $sourceType ($sourceIP)`n"
                }
            }

            # Add packet loss and MOS score details (VoIP)
            $summary += "`nPacket Loss: $packetLoss%`nMOS Score: $mosScore`n"

            # UC Troubleshooting Insights (UC-specific issues)
            $ucResponse = ""
            if ($ucIssues.userPresence) {
                $ucResponse += "UC Issue: User presence status could be incorrect. Check the user's status or availability.`n"
            }
            if ($ucIssues.callRouting) {
                $ucResponse += "UC Issue: Call routing failure detected. Investigate call forwarding or routing rules.`n"
            }
            if ($ucIssues.deviceCompatibility) {
                $ucResponse += "UC Issue: Device registration or configuration issues. Verify device settings or registration status.`n"
            }
            if ($ucIssues.conferenceCall) {
                $ucResponse += "UC Issue: Conference call setup or participant connectivity problems. Review the conference configuration.`n"
            }
            if ($ucIssues.collaborationFeatures) {
                $ucResponse += "UC Issue: Video, screen share, or chat failures. Verify service status and configurations.`n"
            }

            # Add UC troubleshooting information
            if ($ucResponse) {
                $summary += "`nUC Troubleshooting Insights:`n$ucResponse"
            }

            $callSummaries += $summary
        } catch {
            Log-Message "Error while fetching or processing call details for Call ID: $callId - $_" "ERROR"
        }
    }

    return $callSummaries
}


# Fetch PCAP File for the Call
function FetchPCAP {
    param (
        [string]$CallingNumber,
        [string]$CalledNumber,
        [string]$StartDateTime,
        [string]$EndDateTime,
        [string]$TimeZone
    )
    Log-Message "Fetching PCAP for the call..."
    $pcapPayload = @{
        callingNumber = $CallingNumber
        calledNumber = $CalledNumber
        startDateTime = $StartDateTime
        endDateTime = $EndDateTime
        timeZone = $TimeZone
    } | ConvertTo-Json -Depth 10

    try {
        $response = Invoke-RestMethod -Uri $pcapEndpoint -Method Post -Headers $headers -Body $pcapPayload
        $pcapFilePath = "C:\path\to\output\pcap_$CallingNumber" + "_" + (Get-Date -Format "yyyyMMdd_HHmmss") + ".html"
        $response | Out-File -FilePath $pcapFilePath
        Log-Message "PCAP saved to $pcapFilePath"
        return $pcapFilePath
    } catch {
        Log-Message "Error fetching PCAP: $_" "ERROR"
        return $null
    }
}

# Submit Results to Jira
function SubmitToJira {
    param (
        [string]$Summary,
        [string]$Description
    )
    $jiraPayload = @{
        fields = @{
            project = @{
                key = "YourProjectKey"  # Replace with your Jira project key
            }
            summary = $Summary
            description = $Description
            issuetype = @{
                name = "Task"  # Replace with your Jira issue type
            }
        }
    } | ConvertTo-Json -Depth 10

    try {
        $response = Invoke-RestMethod -Uri $jiraCreateTicketEndpoint -Method Post -Headers $jiraHeaders -Body $jiraPayload
        Log-Message "Jira ticket created successfully: $($response.key)"
    } catch {
        Log-Message "Error creating Jira ticket: $_" "ERROR"
    }
}

# Main Script Logic
$calls = SearchCalls
if ($calls -ne $null) {
    $callSummaries = AnalyzeCallDetails -Calls $calls
    $pcapPath = FetchPCAP -CallingNumber $callingNumber -CalledNumber $calledNumber -StartDateTime $startDateTime -EndDateTime $endDateTime -TimeZone $timeZone

    $description = ($callSummaries -join "`n") + "`n`nPCAP File: $pcapPath"
    SubmitToJira -Summary "Call Issue Analysis" -Description $description
}

# Step 3: Create Jira Ticket with Call Flow, Troubleshooting, and UC Insights
function Create-JiraTicket {
    param (
        [array]$CallSummaries
    )

    $ticketSummary = "VoIP & UC Call Flow Analysis and Troubleshooting Report"
    $ticketDescription = "The following call flows have been analyzed, with VoIP and UC troubleshooting insights:`n`n" + ($CallSummaries -join "`n`n")

    # Prepare the troubleshooting insights to be added as an internal comment in Jira
    $troubleshootingComment = "Full Call Flow and Troubleshooting Insights:`n" + ($CallSummaries -join "`n`n")

    $jiraPayload = @{
        fields = @{
            project = @{
                key = "SUPPORT"  # Replace with your Jira project key
            }
            summary = $ticketSummary
            description = $ticketDescription
            issuetype = @{
                name = "Task"  # Replace with your desired issue type
            }
        }
        update = @{
            comment = @(
                @{
                    add = @{
                        body = "$troubleshootingComment"
                    }
                }
            )
        }
    } | ConvertTo-Json -Depth 10 -Compress

    try {
        Log-Message "Creating Jira Ticket..."
        $jiraResponse = Invoke-RestMethod -Uri $jiraCreateTicketEndpoint -Method Post -Headers $jiraHeaders -Body $jiraPayload
        Log-Message "Jira Ticket Created: $($jiraResponse.key)"
    } catch {
        Log-Message "Error while creating Jira Ticket: $_" "ERROR"
    }
}
