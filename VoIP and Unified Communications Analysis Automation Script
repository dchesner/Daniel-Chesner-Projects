# Define SIP Responses Classification
$successfullSipResponses = @{
    "100" = "Trying: The call is being attempted, no action needed."
    "180" = "Ringing: The call is being routed, no action needed."
    "181" = "Call is being forwarded: Normal operation."
    "182" = "Queued: Normal operation, but monitor for delays."
    "183" = "Session Progress: Call is in progress, no action needed."
    "200" = "OK: Call connected successfully."
    "BYE" = "BYE: The call has been properly terminated."
    "ACK" = "ACK: Acknowledgment of a successful response (typically 200 OK)."
}

$failureSipResponses = @{
    "400" = "Bad Request: Check SIP syntax or configurations."
    "401" = "Unauthorized: Verify authentication credentials."
    "403" = "Forbidden: Check permissions or call restrictions."
    "404" = "Not Found: Verify the dialed number."
    "408" = "Request Timeout: Check network connectivity or destination availability."
    "480" = "Temporarily Unavailable: The callee is unavailable, retry later."
    "486" = "Busy Here: The callee is busy, consider retrying later."
    "500" = "Server Internal Error: Check the destination server's health."
    "503" = "Service Unavailable: Check system load, restart services if necessary."
    "504" = "Gateway Timeout: Check gateway availability and connectivity."
    "600" = "Busy Everywhere: All lines are busy, retry later."
    "603" = "Decline: The call was declined by the callee."
    "604" = "Does Not Exist Anywhere: Invalid number, check the input."
